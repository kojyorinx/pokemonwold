{
  "name": "pokemonwold",
  "version": "1.0.0",
  "private": true,
  "description": "YouTubeライブのチャットとポケモンWordleをつなぐ配信向けツール",
  "type": "module",
  "main": "src/desktop.cjs",
  "scripts": {
    "start": "electron .",
    "server": "node src/index.js",
    "test": "node --test",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "dev.pokemonwold.app",
    "productName": "pokemonwold",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "pokemonwold.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
